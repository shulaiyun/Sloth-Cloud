APP_NAME="Sloth Cloud Billing Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://billing.sloth-cloud.example
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=sloth-cloud-db
DB_PORT=3306
DB_DATABASE=slothcloud_paymenter
DB_USERNAME=slothcloud
DB_PASSWORD=replace-with-strong-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=sloth-cloud-redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ASSET_URL=https://billing.sloth-cloud.example
SESSION_DOMAIN=.sloth-cloud.example
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

PROVISIONING_ENABLED=true
PROVISIONING_MAX_ATTEMPTS=5
PROVISIONING_RETRY_BASE_MS=15000
PROVISIONING_RETRY_MAX_MS=180000
PROVISIONING_LOCK_TTL_MS=120000
PROVISIONING_PROVIDERS=convoy,managed-app
PROVISIONING_MAPPING_FILE=/var/runtime/data/provisioning/mappings.json
MANAGED_APP_INTERNAL_API_URL=http://sloth-cloud-api:4000
MANAGED_APP_INTERNAL_API_TOKEN=replace-with-managed-app-internal-token
MANAGED_APP_INTERNAL_API_TIMEOUT=30
