PORT=4000
PAYMENTER_MODE=live
PAYMENTER_API_URL=http://sloth-cloud-paymenter/api
PAYMENTER_TIMEOUT_MS=8000
SESSION_COOKIE_NAME=sloth_sid
SESSION_TOKEN_COOKIE_NAME=sloth_at
SESSION_COOKIE_SECURE=false

CONVOY_ENABLED=true
CONVOY_MODE=live
CONVOY_BASE_URL=http://sloth-convoy-web
CONVOY_APPLICATION_KEY=replace-with-convoy-application-token
CONVOY_TIMEOUT_MS=30000
CONVOY_APPLICATION_PREFIX=/api/application
CONVOY_SERVER_REF_KEYS=convoy_server_uuid,convoy_server_id,convoy_server_short_id,server_uuid

MANAGED_APP_ENABLED=false
MANAGED_APP_DRIVER=contract
MANAGED_APP_KUBECONFIG_PATH=/var/runtime/kubeconfig/config
MANAGED_APP_DEFAULT_CLUSTER_REF=default
MANAGED_APP_NAMESPACE_PREFIX=app
MANAGED_APP_INTERNAL_API_TOKEN=replace-with-managed-app-internal-token
MANAGED_APP_BUILD_NAMESPACE=managed-app-build
MANAGED_APP_BUILDKIT_IMAGE=moby/buildkit:rootless
MANAGED_APP_BUILDKIT_SNAPSHOTTER=native
MANAGED_APP_BUILDKIT_ROOT_PATH=/var/lib/buildkit
MANAGED_APP_BUILDKIT_PRIVILEGED=true
MANAGED_APP_GIT_CLONE_IMAGE=alpine/git:2.45.2
MANAGED_APP_BUILD_EPHEMERAL_REQUEST=1Gi
MANAGED_APP_BUILD_EPHEMERAL_LIMIT=
MANAGED_APP_BUILD_WORKSPACE_SIZE_LIMIT=
MANAGED_APP_BUILDKIT_ROOT_SIZE_LIMIT=
# Whether to forward HTTP(S)_PROXY into K8s build pods.
# Keep false for local/WLS setups using host.docker.internal proxy.
MANAGED_APP_BUILD_FORWARD_PROXY=false
# Optional dedicated proxy for K8s build jobs (recommended over forwarding global proxy).
# These endpoints must be reachable from K8s nodes/pods.
MANAGED_APP_BUILD_HTTP_PROXY=
MANAGED_APP_BUILD_HTTPS_PROXY=
MANAGED_APP_BUILD_NO_PROXY=
# Build pod requests (scheduler footprint). Leave empty for auto-derivation from limits.
# Lower requests improve scheduling success on small clusters.
MANAGED_APP_BUILD_CPU_REQUEST=
MANAGED_APP_BUILD_MEMORY_REQUEST=
# Fallback build base image (prefer a reachable mirror instead of local output registry).
MANAGED_APP_FALLBACK_NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
MANAGED_APP_FALLBACK_NPM_REGISTRY=
# Automatically rewrite `FROM node:*`, `FROM docker.io/node:*`, and
# `FROM docker.io/library/node:*` in user Dockerfiles
# to MANAGED_APP_FALLBACK_NODE_IMAGE.
# to keep builds working when Docker Hub is unreachable from cluster nodes.
MANAGED_APP_REWRITE_NODE_BASE_IMAGE=true
# When true and package.json exists, always use platform generated Dockerfile
# instead of repository Dockerfile (best-effort resilience mode for v1).
MANAGED_APP_PREFER_GENERATED_NODE_DOCKERFILE=false
# Registry host only (no scheme), supports host:port
# Example: 192.168.16.101:30500
MANAGED_APP_IMAGE_REGISTRY=registry.sloth-cloud.local
MANAGED_APP_IMAGE_REGISTRY_INSECURE=false
MANAGED_APP_IMAGE_REPOSITORY_PREFIX=sloth-managed-apps
MANAGED_APP_REGISTRY_AUTH_JSON=
# Leave empty to use the cluster default IngressClass (recommended).
MANAGED_APP_INGRESS_CLASS=
# New managed apps will be auto-assigned as app-{serviceId}.{suffix}
MANAGED_APP_DEFAULT_DOMAIN_SUFFIX=example.com
# Optional cert-manager ClusterIssuer name. Leave empty to disable issuer annotation by default.
MANAGED_APP_CERT_ISSUER=
# Optional StorageClass name. Leave empty to use the cluster default StorageClass (recommended for K3s local-path).
MANAGED_APP_STORAGE_CLASS=

# Intelligent assistant (customer operations bot)
ASSISTANT_ENABLED=true
ASSISTANT_PRIMARY_PROVIDER=openai
ASSISTANT_PROVIDER_CHAIN=openai,gemini,claude
# Development-only escape hatch. Keep false in real runtime to avoid mock replies.
ASSISTANT_ALLOW_DEVELOPMENT_MOCK=false
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_OPENAI_MODEL=gpt-5.4
ASSISTANT_OPENAI_BASE_URL=
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-3.1-pro-high
ASSISTANT_GEMINI_BASE_URL=
ASSISTANT_CLAUDE_API_KEY=
ASSISTANT_CLAUDE_MODEL=claude-sonnet-4-6
ASSISTANT_CLAUDE_BASE_URL=
ASSISTANT_CONFIRM_TTL_SECONDS=600
ASSISTANT_SESSION_TTL_SECONDS=86400
ASSISTANT_MAX_CONTEXT_MESSAGES=30
# Optional fallback link shown when ticket API is unavailable.
ASSISTANT_SUPPORT_WEB_URL=/tickets
# Optional ticket API integration for escalation. If omitted, assistant falls back to guidance mode.
ASSISTANT_TICKET_API_URL=
ASSISTANT_TICKET_API_TOKEN=
ASSISTANT_QUOTA_REDIS_URL=redis://sloth-cloud-redis:6379
ASSISTANT_GUEST_DAILY_POINTS=200000
ASSISTANT_FREE_DAILY_POINTS=2000000
ASSISTANT_PAID_DAILY_POINTS=20000000
ASSISTANT_GUEST_BURST_PER_MINUTE=10
ASSISTANT_USER_BURST_PER_MINUTE=40
ASSISTANT_UNLIMITED_PRODUCT_SLUG=assistant-unlimited-monthly
# Optional but recommended to keep guest quota cookies stable across restarts.
ASSISTANT_QUOTA_COOKIE_SECRET=
ASSISTANT_QUOTA_TIMEZONE=America/Los_Angeles
# Optional SSH fallback for assistant direct execution (used when service password is unavailable).
# Prefer key-based auth first, then agent socket, then password.
ASSISTANT_REMOTE_EXEC_SSH_KEY=
ASSISTANT_REMOTE_EXEC_SSH_KEY_PATH=
ASSISTANT_REMOTE_EXEC_SSH_KEY_PASSPHRASE=
ASSISTANT_REMOTE_EXEC_AGENT_SOCKET=
ASSISTANT_REMOTE_EXEC_DEFAULT_USERNAME=root
ASSISTANT_REMOTE_EXEC_DEFAULT_PORT=22

# Operator capsule persistence and generated project delivery.
OPERATOR_STATE_FILE=
OPERATOR_PREVIEW_BASE_URL=
# Use an address reachable by both browsers and build pods if you want idea
# capsules to flow directly into managed-app builds.
OPERATOR_ARTIFACT_BASE_URL=
# Optional web base URL used when assistant returns capsule links.
OPERATOR_WEB_BASE_URL=

# Cloudflare integration for domain binding + monitoring.
OPERATOR_CLOUDFLARE_API_TOKEN=
OPERATOR_CLOUDFLARE_ACCOUNT_ID=
OPERATOR_CLOUDFLARE_ZONE_ID=
OPERATOR_CLOUDFLARE_ZONE_NAME=
OPERATOR_CLOUDFLARE_DEFAULT_TUNNEL_ID=
# Default origin service used when attaching a hostname into Tunnel ingress.
OPERATOR_CLOUDFLARE_TUNNEL_SERVICE=

# Monitoring relay callback endpoint (must be publicly reachable by Cloudflare).
OPERATOR_MONITORING_WEBHOOK_BASE_URL=
# Optional shared secret checked against `cf-webhook-auth` header.
OPERATOR_MONITORING_WEBHOOK_SECRET=
